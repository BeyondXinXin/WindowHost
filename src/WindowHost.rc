#include <windows.h>
#include "resource.h"
#pragma code_page(65001)

IDI_WINDOWHOST ICON "WindowHost.ico"

IDD_SETTINGS DIALOGEX 0, 0, 252, 174
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WindowHost 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT       "目标进程名（每行一个，含 .exe）", -1, 10, 8, 230, 12
    EDITTEXT    IDC_PROCESS_NAMES, 10, 23, 232, 88, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    AUTOCHECKBOX "底部预留当前显示器的任务栏高度", IDC_TASKBAR, 10, 120, 232, 14
    CONTROL     "保存", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 129, 147, 53, 18
    CONTROL     "取消", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 189, 147, 53, 18
END

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "BeyondXinXin\0"
            VALUE "FileDescription", "WindowHost\0"
            VALUE "OriginalFilename", "WindowHost.exe\0"
            VALUE "ProductName", "WindowHost\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
